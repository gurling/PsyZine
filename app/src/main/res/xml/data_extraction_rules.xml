<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only preferences participate; journals, attachments and staging stay private. -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
